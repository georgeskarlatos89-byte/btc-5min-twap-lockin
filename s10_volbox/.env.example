# Copy to .env and fill in. chmod 600. Never commit.
# Moon Dev liquidations / imbalance feed key (same key as S3/S6).
MOONDEV_API_KEY=

# Keep 0 during calibration and DRY. Flip to 1 only after human sign-off.
LIVE_TRADING=0

# Polymarket key + funder — add ONLY for live incubation (after kill-test passes on DRY).
# POLY_PRIVATE_KEY=
# POLY_FUNDER=
# POLY_SIGNATURE_TYPE=3

# Force-live bypasses the statistical gate check (for emergency testing only; never on by default).
# FORCE_LIVE=0
