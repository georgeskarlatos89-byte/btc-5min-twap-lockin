[Unit]
Description=Measurement stack: history corpus refresh + chain verification
After=network-online.target

[Service]
Type=oneshot
User=ubuntupolymarket3
Group=ubuntupolymarket3
WorkingDirectory=/home/ubuntupolymarket3/arena-ai-copy btc-5-minute workspace/measurement_stack
ExecStart=/bin/bash "/home/ubuntupolymarket3/arena-ai-copy btc-5-minute workspace/measurement_stack/history_tools/history-refresh.sh"
Nice=10
StandardOutput=append:/home/ubuntupolymarket3/arena-ai-copy btc-5-minute workspace/measurement_stack/state/ms-history-refresh.log
StandardError=append:/home/ubuntupolymarket3/arena-ai-copy btc-5-minute workspace/measurement_stack/state/ms-history-refresh.log
