[Unit]
Description=#11 OPEN-BOOK-MAKER (two-sided fair-value maker, BTC 5m; DRY unless .env DRY_RUN=false)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntupolymarket3
WorkingDirectory=/home/ubuntupolymarket3/obm
ExecStart=/usr/bin/python3 -u /home/ubuntupolymarket3/obm/maker_bot.py
Restart=always
RestartSec=5
Nice=5
StandardOutput=append:/home/ubuntupolymarket3/obm/maker_bot.log
StandardError=append:/home/ubuntupolymarket3/obm/maker_bot.log

[Install]
WantedBy=multi-user.target
