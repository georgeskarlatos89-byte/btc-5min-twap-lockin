# ============================================================
# OPEN-BOOK-MAKER — environment template
# Copy to .env, fill it in YOURSELF, then:  chmod 600 .env
# NEVER paste real keys into chat, tickets, or logs.
# ============================================================

# --- MODE ---------------------------------------------------
# true  = log intended quotes only, trade nothing (DEFAULT — start here)
# false = LIVE trading. Only after the Phase-A gate in DECISION.md passed.
DRY_RUN=true

# --- KILL SWITCH ---------------------------------------------
# `touch` this file to cancel every order and pause the bot instantly.
KILL_FILE=./KILL

# --- RISK LIMITS ----------------------------------------------
DAILY_STOP_USD=20
LIVE_QUOTE_SIZE=20
MAX_NET_SHARES=40

# --- LIVE-ONLY CREDENTIALS (leave blank while DRY_RUN=true) ---
# Burner wallet ONLY. Fund it with a few USDC. Not your main wallet.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=
# 0 = EOA direct, 1 = email/magic-link proxy, 2 = browser-wallet proxy
POLYMARKET_SIG_TYPE=2
