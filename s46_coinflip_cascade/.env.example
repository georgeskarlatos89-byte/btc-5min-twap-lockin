# S46 — env template — copy to .env chmod 600, never commit
# No credentials are ever written by the bot; human creates .env on VM over SSH pipe

# Moon Dev API key — moongroup_* class (~1 week lifetime, not 24h rotating moonstream_*)
# Used for all_liquidations/10m.json (1s lag ONLY intra-round feed), totals.json, imbalance/1h.json
# 401/403 -> M7 alarm -> flat. Key lives in Documents file, paste over SSH.
MOONDEV_API_KEY=moongroup_xxxxxxxxxxxxxxxx

# Polymarket — proxy wallet that holds pUSD (funder) + signer private key
# Without funder the client signs as bare EOA (EMPTY wallet) — hard block in gates
POLY_PRIVATE_KEY=0x...
POLY_FUNDER=0x...
POLY_SIGNATURE_TYPE=3

# Trading mode — DRY by default, no orders
# LIVE_TRADING=0 -> DRY (simulated fills from tape, proves plumbing only)
# LIVE_TRADING=1 -> LIVE if all hard gates pass + statistical gates or FORCE_LIVE=1
LIVE_TRADING=0

# Operator override of statistical gates only (arbiter, dry signals) — hard gates stay on
# FORCE_LIVE=1 bypasses LIVE_TRADING!=1 and key checks for testing, still needs hard gates
FORCE_LIVE=0
