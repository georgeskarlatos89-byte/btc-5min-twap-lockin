[Unit]
Description=S46 paired coin-flip harvester (S6) + liquidation cascade continuation (S4, 15m) - DRY unless .env + all gates pass
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntupolymarket3
Group=ubuntupolymarket3
# Runs from the strategy-named folder (symlink ~/s46_coinflip_cascade points here). The code reads
# .env and KILL from its own directory. KILL makes it FLAT (keeps running), so Restart=always
# cannot loop on it. Folder name follows the user's local folder (#4 liquidation cascade
# continuation (15m only)), not the guide's "#4 S4 S6 Paired".
WorkingDirectory=/home/ubuntupolymarket3/#4 liquidation cascade continuation (15m only)/s46_coinflip_cascade
ExecStart=/usr/bin/python3 -u "/home/ubuntupolymarket3/#4 liquidation cascade continuation (15m only)/s46_coinflip_cascade/s46_harvester.py"
Restart=always
RestartSec=10
Nice=2
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/home/ubuntupolymarket3/#4 liquidation cascade continuation (15m only)/s46_coinflip_cascade/s46-harvester.service.log
StandardError=append:/home/ubuntupolymarket3/#4 liquidation cascade continuation (15m only)/s46_coinflip_cascade/s46-harvester.service.log

[Install]
WantedBy=multi-user.target
